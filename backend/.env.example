# Copy to .env. Never commit real credentials.
PORT=3101
NODE_ENV=development
API_KEY=
API_RATE_LIMIT=60
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
# Apply migrations explicitly before enabling durable repositories.
DATABASE_URL=
MOMO_AUTO_MIGRATE=false
MOMO_RECONCILIATION_INTERVAL_MS=300000
REDIS_URL=redis://localhost:6379
STELLAR_NETWORK=testnet
# Testnet endpoints are fixed in code; overrides cannot enable Mainnet.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
OPEN_EXCHANGE_RATES_APP_ID=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_API_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_SECRET=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_SECRET=
# Separate collection/disbursement callback URLs must be registered with MTN.
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_WEBHOOK_TOKEN=
# USSD is a guarded demonstration, not a connected payment product.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=