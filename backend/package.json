{
  "name": "afripay-backend",
  "version": "0.1.0",
  "description": "AfriPay backend API - payments, stellar, mobile money, USSD, KYC, rates, notifications, webhooks",
  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest.js build -p tsconfig.build.json",
    "dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start": "node dist/main",
    "lint": "node node_modules/eslint/bin/eslint.js src/**/*.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@stellar/stellar-sdk": "17.3.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "^8.57.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+[.]ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
